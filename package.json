{
  "name": "run-mcp",
  "version": "3.0.0",
  "description": "A thin MCP client for humans and agents \u2014 run any Model Context Protocol server, call its tools, read its stderr, and reconnect after each edit. Speaks both protocol eras (2025 and 2026-07-28). REPL, headless CLI, or an MCP server your agent drives. No client config edits, no restarts.",
  "homepage": "https://github.com/funkyfunc/run-mcp#readme",
  "bugs": {
    "url": "https://github.com/funkyfunc/run-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funkyfunc/run-mcp.git"
  },
  "license": "MIT",
  "author": "funkyfunc",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "mcp-client",
    "mcp-server",
    "model-context-protocol",
    "mcp-testing",
    "mcp-development",
    "mcp-inspector",
    "repl",
    "cli",
    "test-harness",
    "testing",
    "debugging",
    "developer-tools",
    "ai-agents",
    "agent-tools",
    "claude",
    "llm",
    "stdio"
  ],
  "bin": {
    "run-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsup && node scripts/update-readme-help.js",
    "build:fixtures": "tsup tests/fixtures/mock-server.ts tests/fixtures/second-server.ts --format esm --target node20 --out-dir tests/fixtures/dist",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"*.{ts,js,json}\"",
    "pretest": "tsup && npm run build:fixtures",
    "test": "vitest run",
    "update-schema": "node scripts/update-schema.js",
    "prepublishOnly": "npm run build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "tree-kill": "^1.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server-legacy": "^2.0.0",
    "@types/node": "^22.13.14",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.1",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format && npm run lint && npm run typecheck && npm test"
  }
}
